{
  "name": "hdhive-api",
  "version": "2.0.0",
  "description": "HDHive API 客户端 - REST API 服务",
  "private": true,
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "check": "node --check server.mjs && node --check api-client.mjs",
    "docker:build": "docker build -t hdhive-api:latest .",
    "docker:run": "docker run --rm -p 10000:10000 -e BRIDGE_TOKEN=test -e HDHIVE_COOKIE=\"$HDHIVE_COOKIE\" hdhive-api:latest",
    "test:api": "node test-api-client.mjs",
    "test:bench": "node benchmark-v3.mjs",
    "test:stability": "node stability.mjs"
  },
  "dependencies": {
    "express": "^4.18.3",
    "playwright": "1.49.1"
  },
  "engines": {
    "node": ">=18"
  }
}